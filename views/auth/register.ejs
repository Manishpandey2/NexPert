<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Join NexPert</title>

<link rel="stylesheet" href="register.css">
</head>

<body>

<div class="container">

    <!-- LEFT SIDE -->
    <div class="left">
        <h1>Welcome to NexPert</h1>
        <p>
            Join a growing community where people ask questions 
            and experts provide trusted answers.
            Learn, share, and grow together.
        </p>
    </div>

    <!-- RIGHT SIDE -->
    <div class="right">

        <div class="title">Create your account</div>

        <!-- ROLE SELECTION -->
        <div class="roles">
            <div class="role">
                <h3>🙋 Ask Questions</h3>
                <p>Find answers from experts and community.</p>
            </div>

            <div class="role">
                <h3>🧑‍🏫 Become Expert</h3>
                <p>Share knowledge and help others.</p>
            </div>
        </div>

        <!-- FORM -->
        <form action="/register" method="post">
            <input type="text" placeholder="Full Name" name="fullName">
            <input type="email" placeholder="Email Address" name="email">
            <input type="password" placeholder="Password" name="password">
            <input type="password" placeholder="Confirm Password" name="ConfirmPassword">

            <button class="btn btn-primary">Create Account</button>
        </form>

        <div class="divider">OR</div>

        <button class="btn" style="width:100%; background:#e2e8f0;">
            Continue with Google
        </button>

        <div class="footer-text">
            Already have an account? <a href="/login">Login</a>
        </div>

    </div>

</div>

</body>
</html>